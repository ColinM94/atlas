{
  "compilerOptions": {
    /* Environment */
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "constants/*": ["./src/constants/*"],
      "hooks/*": ["./src/hooks/*"],
      "inits/*": ["./src/inits/*"],
      "layouts/*": ["./src/layouts/*"],
      "pages/*": ["./src/pages/*"],
      "services/*": ["./src/services/*"],
      "styles/*": ["./src/styles/*"],
      "stores/*": ["./src/stores/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"]
    },

    /* Module & Interop */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": false,

    /* Build Behavior */
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    /* Linting & Strictness */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true
  },
  "include": ["src", "global.d.ts", "vite.config.ts", "oxlint.config.ts"]
}
